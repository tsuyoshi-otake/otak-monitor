{
  "name": "otak-monitor",
  "displayName": "otak-monitor",
  "description": "%extension.description%",
  "version": "1.2.5",
  "publisher": "odangoo",
  "license": "MIT",
  "icon": "images/otak-monitor-icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsuyoshi-otake/otak-monitor"
  },
  "bugs": {
    "url": "https://github.com/tsuyoshi-otake/otak-monitor/issues"
  },
  "homepage": "https://github.com/tsuyoshi-otake/otak-monitor#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "otak-monitor.copyMetrics",
        "title": "%command.copyMetrics.title%",
        "category": "Otak Monitor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "package:vsix": "vsce package",
    "deploy": "vsce publish --skip-duplicate",
    "deploy:ovsx": "ovsx publish --skip-duplicate"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.5",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.13",
    "brace-expansion@2": "2.0.3",
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
